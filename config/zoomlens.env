# Zoom-Lens demo settings. Every value can be overridden from the environment,
# e.g.:  ZL_IMAGE_TAG=v1 ZL_REGISTRY=ghcr.io/me ./scripts/deploy-all.sh
#
# Values here are only defaults; scripts never overwrite variables that are
# already set in the environment.

# Image tag for the three images built from this repo.
ZL_IMAGE_TAG="${ZL_IMAGE_TAG:-dev}"

# Where images go:
#   empty      -> the current cluster must be kind; images are loaded with
#                 `kind load docker-image` (no registry needed)
#   non-empty  -> images are pushed to this registry prefix, e.g.
#                 ghcr.io/<you> or registry.example.com/zoomlens
ZL_REGISTRY="${ZL_REGISTRY:-}"

# kind cluster name (used by 01-create-kind-cluster.sh and `kind load`).
ZL_KIND_CLUSTER="${ZL_KIND_CLUSTER:-zoomlens}"

# Optional docker build platform, e.g. linux/amd64 when building on an
# arm64 laptop for amd64 cluster nodes. Empty = the Docker host's platform.
ZL_PLATFORM="${ZL_PLATFORM:-}"

# Optional Go module proxy used inside the image build (corporate networks).
ZL_GOPROXY="${ZL_GOPROXY:-https://proxy.golang.org,direct}"

# Pinned third-party versions (verified to exist as multi-arch images).
ZL_OTEL_VERSION="${ZL_OTEL_VERSION:-0.161.0}"
ZL_EBPF_IMAGE="${ZL_EBPF_IMAGE:-ghcr.io/cloudflare/ebpf_exporter:v2.5.1}"
ZL_KPS_CHART_VERSION="${ZL_KPS_CHART_VERSION:-91.8.2}"

# The curated root alert rules (knowledge/generated/prometheusrule.yaml) use
# upstream "for:" durations of 5m to 1h. For a live demo, override every
# "for:" with this value. Empty keeps the upstream durations.
ZL_KNOWLEDGE_RULE_FOR="${ZL_KNOWLEDGE_RULE_FOR:-1m}"

# Helm release name and namespace for kube-prometheus-stack.
ZL_KPS_RELEASE="${ZL_KPS_RELEASE:-kps}"
ZL_MONITORING_NS="${ZL_MONITORING_NS:-monitoring}"

# Node that hosts the demo app and its noisy neighbours. Empty = the first
# schedulable worker node (a node without the control-plane role).
ZL_DEMO_NODE="${ZL_DEMO_NODE:-}"

# Timeouts.
ZL_WAIT_TIMEOUT="${ZL_WAIT_TIMEOUT:-600s}"
